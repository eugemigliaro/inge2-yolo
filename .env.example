# Copiar a .env. No commitear .env.
# Las claves salen del dashboard de Clerk. Sin ellas la app no autentica.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Solo hace falta cambiarla en el despliegue. En local el compose usa "yolo".
POSTGRES_PASSWORD=yolo

# Contraseña de las cinco cuentas de demo (bun scripts/clerk.mjs). Mínimo 15 caracteres.
# No va en el repositorio: se reparte con la entrega.
DEMO_PASSWORD=
